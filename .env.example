POSTGRES_DB=lamdong_ocop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Chỉ cần khi chạy backend ngoài Docker. Docker Compose tự tạo DATABASE_URL.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/lamdong_ocop
JWT_SECRET_KEY=replace-with-a-random-value-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
NEWS_RSS_URL=https://ocoplamdong.gov.vn/rssChanel/tin-tuc-su-kien.rss
NEWS_RSS_TIMEOUT_SECONDS=8
NEWS_RSS_MAX_BYTES=1048576
NEWS_CACHE_TTL_SECONDS=900
# Bản đồ số: máy chủ OSRM dùng để gợi ý tuyến đường (backend gọi, có giới hạn thời gian chờ).
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=8

# Lưu ảnh sản phẩm và ảnh điểm du lịch: local (thư mục uploads, mặc định) hoặc cloudinary.
# Chỉ điền ba biến CLOUDINARY_* khi IMAGE_STORAGE=cloudinary; lấy ở trang Dashboard của Cloudinary. Không commit giá trị thật.
IMAGE_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ocop
