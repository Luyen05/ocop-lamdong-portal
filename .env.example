POSTGRES_DB=lamdong_ocop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Chỉ cần khi chạy backend ngoài Docker. Docker Compose tự tạo DATABASE_URL.
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/lamdong_ocop
JWT_SECRET_KEY=replace-with-a-random-value-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
