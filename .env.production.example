# Mẫu cấu hình chạy thật cho docker-compose.prod.yml. Sao chép thành .env.production (không commit) rồi điền.
# Cách tạo chuỗi ngẫu nhiên:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Địa chỉ công khai của website, không có dấu / ở cuối. Dùng cho CORS, URL ảnh, sitemap, quay lại sau đăng nhập Google/Facebook.
SITE_URL=https://ocop.example.vn

POSTGRES_DB=lamdong_ocop
POSTGRES_USER=ocop
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

# Cổng HTTP của Nginx trên máy chủ.
WEB_PORT=80

# Ảnh: local (volume backend_uploads) hoặc cloudinary (điền ba khóa bên dưới).
IMAGE_STORAGE=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ocop

# Đăng nhập Google/Facebook (tùy chọn, xem docs/CAU_HINH.md mục 3). Trống thì ẩn nút.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
