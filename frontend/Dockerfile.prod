# Giai đoạn 1: build bản tĩnh. VITE_API_BASE_URL được nhúng vào mã lúc build.
FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
# Mặc định gọi API cùng tên miền (Nginx chuyển /api/ về backend) nên không cần CORS.
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

# Giai đoạn 2: Nginx phục vụ bản tĩnh và chuyển tiếp API. Cấu hình ở nginx/default.conf.
FROM nginx:1.27-alpine

COPY nginx/default.conf /etc/nginx/conf.d/default.conf
COPY nginx/proxy_params.inc /etc/nginx/conf.d/proxy_params.inc
COPY nginx/security_headers.inc /etc/nginx/conf.d/security_headers.inc
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
